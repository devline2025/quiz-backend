# Server Port Configuration
PORT=3000

# Comma-separated browser origins allowed to submit quiz answers
ALLOWED_ORIGINS=http://localhost:5501,http://127.0.0.1:5501,https://devline2025.github.io

# Server-side administration key. Never place this value in frontend code.
ADMIN_API_KEY=replace_with_a_long_random_secret

# PostgreSQL Connection URI
DATABASE_URL=postgresql://username:password@localhost:5432/databasename

# Google Sheets Spreadsheet ID for Vouchers
SHEET_ID=your_google_sheet_spreadsheet_id_here
